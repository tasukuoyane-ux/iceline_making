# ===== 管理コンソール (/console) ・記事管理 (/admin) 用の環境変数 =====
# Vercel のプロジェクト設定 > Environment Variables に登録してください。
# （ローカル開発では .env にコピーして設定）

# --- 認証（/console） ---
# JWTの署名鍵。十分に長いランダム文字列を設定（例: openssl rand -hex 32）
JWT_SECRET=

# 社員アカウント一覧（JSON配列）。passwordHash は scripts/hash-password.mjs で生成。
# 例: [{"username":"tanaka","name":"田中太郎","passwordHash":"$2a$10$..."}]
# 注意: ローカルの .env に書く場合、Next.js は $ を変数展開するため
#       ハッシュ内の $ は \$ とエスケープすること（Vercel のダッシュボード登録では不要）
CONSOLE_USERS=

# --- 公開（GitHubへコミット → Vercel自動デプロイ）---
# repo の contents への書き込み権限を持つ GitHub トークン（fine-grained 推奨）
GITHUB_TOKEN=
GITHUB_OWNER=tasukuoyane-ux
GITHUB_REPO=
# 本番ブランチ（未設定なら main）
GITHUB_BRANCH=main

# --- 画像アップロード（Vercel Blob）---
# Vercel ダッシュボードで Blob ストアを作成すると自動で注入されます。
# 手動で使う場合のみ設定してください。
BLOB_READ_WRITE_TOKEN=

# --- 記事管理（Payload CMS / /admin） ---
# Neon (Postgres) の接続文字列。Vercel の Storage > Neon を Connect すると自動で注入されます。
POSTGRES_URL=
# マイグレーション用の直結（PgBouncer を通さない）接続文字列。Neon 接続時に自動注入。
POSTGRES_URL_NON_POOLING=
# Payload のセッション署名・暗号化キー（openssl rand -hex 32 等で生成）
PAYLOAD_SECRET=

# --- お問い合わせフォーム（/api/contact、Resend でメール送信） ---
# Resend の API キー
RESEND_API_KEY=
# 送信元（Resend で認証したドメインのアドレス。未設定なら onboarding@resend.dev）
CONTACT_FROM=
# 送信先（管理コンソールの「お問い合わせ設定」が空のときのフォールバック）
CONTACT_RECIPIENT=
